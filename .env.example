# ============================================================
# Gold Terminal — environment template
# Copy to .env and fill in real values. .env is git-ignored.
# ============================================================

# ---- PostgreSQL / TimescaleDB ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gold_terminal
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Optional: full override. If set, it wins over the discrete DB_* vars.
# DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/gold_terminal

# Pool tuning (optional)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# ---- External data APIs ----
FRED_API_KEY=your_fred_api_key_here

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Auth ----
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# ---- Python collectors ----
# Used by collectors/*.py via python-dotenv
COLLECTOR_LOG_LEVEL=INFO
COLLECTOR_TICK_INTERVAL_SEC=5
COLLECTOR_CANDLE_INTERVAL_SEC=60
